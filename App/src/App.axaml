<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Markwardt.Browser.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>

    <Style Selector="Path.lineIcon">
      <Setter Property="Stroke" Value="{DynamicResource Muted}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Button.icon:pointerover Path.lineIcon">
      <Setter Property="Stroke" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.icon:disabled Path.lineIcon">
      <Setter Property="Opacity" Value="0.35" />
    </Style>

    <Style Selector="Border.topbar">
      <Setter Property="Background" Value="{DynamicResource TitleBar}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.topbar Button.pin.on Path.lineIcon">
      <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.topbar Button.window">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="43" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.topbar Button.window:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Border.topbar Button.window.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E81123" />
    </Style>
    <Style Selector="Border.topbar Button.window Path.lineIcon">
      <Setter Property="Stroke" Value="{DynamicResource Text}" />
    </Style>

    <Style Selector="TextBox.address">
      <Setter Property="Background" Value="{DynamicResource Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.address:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="TextBox.address:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>

    <Style Selector="Button.star Path.lineIcon">
      <Setter Property="Stroke" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Button.star.on Path.lineIcon">
      <Setter Property="Stroke" Value="{DynamicResource Accent}" />
      <Setter Property="Fill" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="Border.bookmark">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="16,6,6,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.bookmark:pointerover">
      <Setter Property="Background" Value="#2A2D2E" />
    </Style>
    <Style Selector="Border.bookmark Button.icon">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.bookmark:pointerover Button.icon">
      <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="TextBox.rename">
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBox.suggestions ListBoxItem">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <Style Selector="Border.findbar">
      <Setter Property="Background" Value="{DynamicResource Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,12,24,0" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.dialog">
      <Setter Property="Background" Value="{DynamicResource Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Width" Value="440" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.matchCase">
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.matchCase.on">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.matchCase.on /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Width" Value="300" />
      <Setter Property="Height" Value="214" />
      <Setter Property="Margin" Value="12" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.card:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Border.card.on">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.card Button.icon">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Border.card:pointerover Button.icon">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.card Button.lock.on">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.card Button.lock.auto">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.card Button.lock.auto Path.lineIcon">
      <Setter Property="Stroke" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Border.card Button.lock.on Path.lineIcon">
      <Setter Property="Stroke" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.card.frozen">
      <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Border.card.suspended">
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="Border.edge">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource Elevated}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <Color x:Key="SystemAccentColor">#007ACC</Color>
      <Color x:Key="SystemAccentColorLight1">#1F8AD2</Color>
      <Color x:Key="SystemAccentColorLight2">#4BA3DD</Color>
      <Color x:Key="SystemAccentColorLight3">#75BDE8</Color>
      <Color x:Key="SystemAccentColorDark1">#0065A9</Color>
      <Color x:Key="SystemAccentColorDark2">#005289</Color>
      <Color x:Key="SystemAccentColorDark3">#003F6B</Color>
      <SolidColorBrush x:Key="Background" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Surface" Color="#252526" />
      <SolidColorBrush x:Key="Elevated" Color="#2D2D2D" />
      <SolidColorBrush x:Key="TitleBar" Color="#3C3C3C" />
      <SolidColorBrush x:Key="Scrim" Color="#181818" />
      <SolidColorBrush x:Key="Border" Color="#3C3C3C" />
      <SolidColorBrush x:Key="Text" Color="#CCCCCC" />
      <SolidColorBrush x:Key="Muted" Color="#969696" />
      <SolidColorBrush x:Key="Accent" Color="#007ACC" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#252526" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#454545" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#094771" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#094771" />
      <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#CCCCCC" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="White" />
      <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="White" />
      <Geometry x:Key="LockIconGeometry">M3.5,6.5 L10.5,6.5 L10.5,12 L3.5,12 Z M5,6.5 L5,4.6 A2,2 0 0 1 9,4.6 L9,6.5</Geometry>
      <Geometry x:Key="StarIconGeometry">M7,1 L8.9,5.1 L13.4,5.6 L10,8.7 L10.9,13.1 L7,10.9 L3.1,13.1 L4,8.7 L0.6,5.6 L5.1,5.1 Z</Geometry>
      <Geometry x:Key="PlusIconGeometry">M7,2 L7,12 M2,7 L12,7</Geometry>
      <Geometry x:Key="PencilIconGeometry">M2,12 L2.7,9 L9.5,2.2 A1.4,1.4 0 0 1 11.8,4.5 L5,11.3 Z M8.2,3.6 L10.4,5.8</Geometry>
      <Geometry x:Key="BackIconGeometry">M12,7 L2,7 M6.5,2.5 L2,7 L6.5,11.5</Geometry>
      <Geometry x:Key="ForwardIconGeometry">M2,7 L12,7 M7.5,2.5 L12,7 L7.5,11.5</Geometry>
      <Geometry x:Key="ReloadIconGeometry">M11.5,7 A4.5,4.5 0 1 1 10.3,3.9 M10.9,1.6 L10.3,4.2 L7.7,3.6</Geometry>
      <Geometry x:Key="NewWindowIconGeometry">M1.5,2.5 L12.5,2.5 L12.5,11.5 L1.5,11.5 Z M1.5,5 L12.5,5 M7,6.4 L7,10 M5.2,8.2 L8.8,8.2</Geometry>
      <Geometry x:Key="TopBarIconGeometry">M2,2.5 L12,2.5 L12,11.5 L2,11.5 Z M2,5.5 L12,5.5</Geometry>
      <Geometry x:Key="UpIconGeometry">M2.5,9 L7,4.5 L11.5,9</Geometry>
      <Geometry x:Key="DownIconGeometry">M2.5,5 L7,9.5 L11.5,5</Geometry>
      <Geometry x:Key="CloseIconGeometry">M2,2 L12,12 M12,2 L2,12</Geometry>
      <Geometry x:Key="MinimizeIconGeometry">M1,1 M13,13 M2,7 L12,7</Geometry>
      <Geometry x:Key="MaximizeIconGeometry">M2.5,2.5 L11.5,2.5 L11.5,11.5 L2.5,11.5 Z</Geometry>
    </ResourceDictionary>
  </Application.Resources>
</Application>
